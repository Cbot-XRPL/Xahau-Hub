# ══════════════════════════════════════════════════════════════════════════════
#  xahaud.cfg — RENDERED FILE. DO NOT EDIT ON THE NODE.
#
#  node     : {{ node_name }}   (vmid {{ vmid }}, role {{ role }})
#  rendered : {{ rendered_at }} from {{ template_name }}
#  source   : {{ repo }}  —  edit config/xahaud.cfg.j2 + inventory.yml instead
#
#  Xahau {{ network }} — NetworkID {{ network_id }}
#
#  This file contains a node_seed. It is gitignored and must never be
#  committed, pasted, or copied to another node.
# ══════════════════════════════════════════════════════════════════════════════

[network_id]
{{ network_id }}

[server]
port_rpc_admin_local
port_peer
port_ws_public
port_rpc_public

# ── Admin. 127.0.0.1 ONLY. NEVER proxied, never bound to 0.0.0.0. ───────────
[port_rpc_admin_local]
port = {{ port_rpc_admin }}
ip = 127.0.0.1
admin = 127.0.0.1
protocol = http

[port_peer]
port = {{ port_peer }}
ip = 0.0.0.0
protocol = peer

[port_ws_public]
port = {{ port_ws_public }}
ip = 0.0.0.0
protocol = ws

[port_rpc_public]
port = {{ port_rpc_public }}
ip = 0.0.0.0
protocol = http

# ══════════════════════════════════════════════════════════════════════════════
#  Storage
#  database_path lives on the dedicated XFS volume mounted at {{ db_mount }}
#  (LABEL={{ db_label }}, nofail). The volume's SIZE is the containment
#  boundary: xahaud must hit ENOSPC on its own volume and stop, rather than
#  growing into the thin pool that holds the other VMs.
# ══════════════════════════════════════════════════════════════════════════════

[node_db]
type=NuDB
path={{ db_mount }}/db/nudb
online_delete={{ online_delete }}
advisory_delete={{ advisory_delete }}

[database_path]
{{ db_mount }}/db

[ledger_history]
{{ ledger_history }}

[node_size]
{{ node_size }}

[peers_max]
{{ peers_max }}

# ── SQLite ───────────────────────────────────────────────────────────────────
#  page_size MUST be set at first start. With the 4096 default a history
#  server can exhaust its transaction database while disk is still free, and
#  the only fix is `xahaud --vacuum` before restart — which can run for days.
#  See docs/DECISIONS.md.
[sqlite]
page_size={{ sqlite_page_size }}
journal_mode={{ sqlite_journal_mode }}
synchronous={{ sqlite_synchronous }}
temp_store={{ sqlite_temp_store }}

# ── Transaction tables ───────────────────────────────────────────────────────
#  account_tx depends on these and account_tx is the entire point of a public
#  history endpoint. Leave this on. Never set it to 0.
[use_tx_tables]
{{ use_tx_tables }}

[debug_logfile]
/var/log/xahaud/debug.log

# ── Time ─────────────────────────────────────────────────────────────────────
#  xahaud keeps its own time sync independently of chrony. Consensus is
#  time-sensitive and a skewed clock misbehaves subtly rather than obviously.
[sntp_servers]
{{ sntp_servers_block }}

[rpc_startup]
{ "command": "log_level", "severity": "{{ log_level }}" }

[ssl_verify]
1

# ══════════════════════════════════════════════════════════════════════════════
#  Identity — UNIQUE PER NODE. Generated with validation_create, stored in
#  secrets/seeds.env outside the repo, injected at render time.
#  A copied seed means two nodes with one identity on the network.
# ══════════════════════════════════════════════════════════════════════════════

{{ node_seed_block }}

# ══════════════════════════════════════════════════════════════════════════════
#  UNL — the published Xahau validator list. These are stock nodes; they do
#  not validate. Trust comes from this list, not from [cluster_nodes].
# ══════════════════════════════════════════════════════════════════════════════

[validators_file]
/etc/opt/xahaud/validators.txt

# ══════════════════════════════════════════════════════════════════════════════
#  Cluster — regenerated by cluster/render-cluster-nodes.sh from live
#  pubkey_node values. Adding a node means adding an inventory entry and
#  re-running that script; never hand-edit these two blocks.
#
#  What clustering buys: shared load and fee-escalation state, shared client
#  abuse accounting, and relayed transactions skipping redundant signature
#  verification. It has NO effect on consensus or trust.
# ══════════════════════════════════════════════════════════════════════════════

{{ cluster_nodes_block }}

{{ ips_fixed_block }}
