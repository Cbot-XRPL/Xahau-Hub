# ══════════════════════════════════════════════════════════════════════════════
#  Copy to secrets/seeds.env (gitignored, chmod 600) and fill in real values.
#
#  DO NOT invent these. Generate each one with validation_create:
#
#      make seed NODE=xah-node-1
#
#  which runs ops/gen-seed.sh, refuses a duplicate, and appends it here with
#  the right permissions.
#
#  One UNIQUE seed per node. Never reuse one. Never derive one from the UNL
#  validator's key — nothing in this repo has access to CT 200 on the R730xd
#  and that is deliberate.
# ══════════════════════════════════════════════════════════════════════════════

XAH_NODE_1_SEED=sEXAMPLExxxxxxxxxxxxxxxxxxxxx
XAH_NODE_2_SEED=sEXAMPLExxxxxxxxxxxxxxxxxxxxx

# Phase 2 — mint when node 3 is built, not before.
#XAH_NODE_3_SEED=
